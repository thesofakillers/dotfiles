{
  "permissions": {
    "allow": [
      "Read(/Users/thesofakillers/.fieldtheory/handoffs/*)",
      "Write(/Users/thesofakillers/.fieldtheory/handoffs/*)",
      "Edit(/Users/thesofakillers/.fieldtheory/handoffs/*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/thesofakillers/.claude/fieldtheory-read-permission-hook.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "autoUpdatesChannel": "stable"
}
