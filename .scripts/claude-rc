#!/usr/bin/env bash
# Start Claude Code Remote Control servers in a detached tmux session, one
# window per repo, so new sessions can be spawned from the Claude mobile app or
# claude.ai/code. Idempotent: existing windows are left running unless
# --restart is given (use it after a CLI update; running servers keep the old
# binary until restarted).
#
# Usage: claude-rc [--restart] [repo-dir ...]
#        (default: ~/repos/paradigma ~/repos/dotfiles)
# Attach: tmux attach -t claude

set -euo pipefail

session="${CLAUDE_RC_SESSION:-claude}"
restart=0
if [[ "${1:-}" == "--restart" ]]; then
  restart=1
  shift
fi
if (($# == 0)); then
  set -- "$HOME/repos/paradigma" "$HOME/repos/dotfiles"
fi

# Drop state inherited from whatever launched us. When run from inside a Claude
# Code session (e.g. the desktop app) the env carries that session's IDs, a
# local ANTHROPIC_BASE_URL proxy and DISABLE_AUTOUPDATER, which a new tmux
# server would otherwise bake into its global environment. ~/.secrets exports
# ANTHROPIC_API_KEY, which would take precedence over the claude.ai login that
# Remote Control (and its spawned sessions) need; the login shell re-sources it,
# so scrub again inside the window.
scrub='unset DISABLE_AUTOUPDATER ${!CLAUDE@} ${!ANTHROPIC_@}'
eval "$scrub"
# Spawned sessions ignore Chrome's "Enabled by default" setting; they connect
# Claude in Chrome only when the server itself starts with CLAUDE_CODE_ENABLE_CFC=1.
# The server gives up after ~10 minutes without the network (e.g. laptop sleep),
# so keep relaunching it; Ctrl-C during the pause (or kill the window) stops it.
cmd="$scrub; export CLAUDE_CODE_ENABLE_CFC=1; while :; do claude --dangerously-skip-permissions rc --spawn=worktree; echo \"claude-rc: server exited (\$?), restarting in 30s\"; sleep 30 || break; done"

for dir in "$@"; do
  [[ -d "$dir" ]] || { printf 'claude-rc: skipping missing %s\n' "$dir" >&2; continue; }
  name="$(basename "$dir")"
  if ((restart)) && tmux list-windows -t "=$session" -F '#{window_name}' 2>/dev/null | grep -qx "$name"; then
    tmux kill-window -t "=$session:=$name"
    printf 'claude-rc: restarting %s:%s\n' "$session" "$name"
  fi
  if ! tmux has-session -t "=$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -n "$name" -c "$dir" "bash -lc '$cmd'"
  elif ! tmux list-windows -t "=$session" -F '#{window_name}' | grep -qx "$name"; then
    tmux new-window -d -t "=$session:" -n "$name" -c "$dir" "bash -lc '$cmd'"
  else
    printf 'claude-rc: %s:%s already running\n' "$session" "$name"
  fi
done

tmux list-windows -t "=$session" -F "$session:#{window_index} #{window_name} #{pane_current_path}"
