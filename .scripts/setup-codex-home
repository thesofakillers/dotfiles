#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-codex-home [--apply | --check]

Required layout:
  <dotfiles>/.codex/  Git-tracked Codex configuration source
  ~/.codex/           Real, mutable Codex runtime directory
  ~/.codex/<tracked>  Individual links to <dotfiles>/.codex/<tracked>
  <dotfiles>/.agents/ Git-tracked skills and skill lock source
  ~/.agents/          Link to <dotfiles>/.agents

Modes:
  --check  Verify the boundary without changing anything. This is the default.
  --apply  Create or repair only the managed configuration links.

This helper never reads, moves, or edits Codex databases, sessions, rollouts,
plugins, caches, or worktrees. It refuses a whole-directory ~/.codex symlink
because resolving mixed runtime state requires a separate, backed-up migration.

Full setup notes: docs/codex.md
EOF
}

log() {
  printf '[codex-home] %s\n' "$*"
}

die() {
  printf '[codex-home] error: %s\n' "$*" >&2
  exit 1
}

script_dir="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
repo_codex="$repo_root/.codex"
repo_agents="$repo_root/.agents"
codex_home_path="${CODEX_HOME:-$HOME/.codex}"
agents_home_path="$HOME/.agents"
mode=check

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)
      mode=apply
      ;;
    --check)
      mode=check
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "unknown argument: $1"
      ;;
  esac
  shift
done

[[ -d "$repo_codex" ]] || die "missing repository Codex directory: $repo_codex"
[[ -d "$repo_agents" ]] || die "missing repository agents directory: $repo_agents"
[[ "$codex_home_path" != "$repo_codex" ]] || \
  die "CODEX_HOME must not be the repository .codex directory"

managed_files=()
while IFS= read -r -d '' managed_path; do
  managed_files+=("$managed_path")
done < <(git -C "$repo_root" ls-files -z -- .codex)

[[ ${#managed_files[@]} -gt 0 ]] || die "no Git-tracked .codex files found"

is_expected_link() {
  local destination="$1"
  local source="$2"
  [[ -L "$destination" ]] && [[ "$(readlink "$destination")" == "$source" ]]
}

check_layout() {
  local failures=0
  local managed_path relative_path source destination
  local ignored_count untracked_count legacy_repo_skill_count
  local legacy_runtime_skill_manifest legacy_runtime_skill_name
  local legacy_runtime_skill_count=0 global_skill_count=0
  local legacy_runtime_skill_names=()

  if [[ -L "$codex_home_path" ]]; then
    log "$codex_home_path must be a real directory, not a whole-directory symlink"
    failures=$((failures + 1))
  elif [[ ! -d "$codex_home_path" ]]; then
    log "$codex_home_path does not exist"
    failures=$((failures + 1))
  else
    for managed_path in "${managed_files[@]}"; do
      relative_path="${managed_path#.codex/}"
      source="$repo_codex/$relative_path"
      destination="$codex_home_path/$relative_path"
      if ! is_expected_link "$destination" "$source"; then
        log "managed configuration is not linked: $destination"
        failures=$((failures + 1))
      fi
    done
  fi

  if [[ ! -d "$agents_home_path" ]] || [[ ! "$agents_home_path" -ef "$repo_agents" ]]; then
    log "$agents_home_path must resolve to the repository agents directory: $repo_agents"
    failures=$((failures + 1))
  fi

  legacy_repo_skill_count="$(git -C "$repo_root" ls-files -- '.codex/skills/*/SKILL.md' | wc -l | tr -d ' ')"
  if [[ "$legacy_repo_skill_count" -ne 0 ]]; then
    log "repository contains $legacy_repo_skill_count authored skills under .codex/skills; use .agents/skills"
    failures=$((failures + 1))
  fi

  for legacy_runtime_skill_manifest in "$codex_home_path"/skills/*/SKILL.md; do
    [[ -f "$legacy_runtime_skill_manifest" ]] || continue
    legacy_runtime_skill_name="$(basename "$(dirname "$legacy_runtime_skill_manifest")")"
    legacy_runtime_skill_names+=("$legacy_runtime_skill_name")
    legacy_runtime_skill_count=$((legacy_runtime_skill_count + 1))
  done
  if [[ "$legacy_runtime_skill_count" -ne 0 ]]; then
    log "$codex_home_path/skills contains legacy user skills: ${legacy_runtime_skill_names[*]}"
    log "user-authored skills belong under $agents_home_path/skills"
    failures=$((failures + 1))
  fi

  ignored_count="$(git -C "$repo_root" ls-files --others --ignored --exclude-standard -- .codex | wc -l | tr -d ' ')"
  untracked_count="$(git -C "$repo_root" ls-files --others --exclude-standard -- .codex | wc -l | tr -d ' ')"
  if [[ "$ignored_count" -ne 0 || "$untracked_count" -ne 0 ]]; then
    log "repository .codex contains non-config files (ignored=$ignored_count untracked=$untracked_count)"
    log "review and move runtime-owned files manually; this helper will not touch them"
    failures=$((failures + 1))
  fi

  if [[ -d "$agents_home_path/skills" ]]; then
    global_skill_count="$(find -L "$agents_home_path/skills" -mindepth 2 -maxdepth 2 -type f -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')"
  fi

  [[ "$failures" -eq 0 ]] || return 1

  log "configuration source: $repo_codex"
  log "runtime home: $codex_home_path"
  log "global skills root: $agents_home_path -> $repo_agents"
  log "layout is healthy: ${#managed_files[@]} managed configuration links and $global_skill_count global skills"
}

if [[ "$mode" == check ]]; then
  check_layout
  exit $?
fi

if [[ -L "$codex_home_path" ]]; then
  die "$codex_home_path is a whole-directory symlink; preserve its target and perform a separate backed-up migration"
fi
if [[ -e "$codex_home_path" && ! -d "$codex_home_path" ]]; then
  die "$codex_home_path exists but is not a directory"
fi

backup_root="$HOME/.dotfiles-backups/$(date +%Y%m%d-%H%M%S)-codex-links"
mkdir -p "$codex_home_path"

if [[ ! -d "$agents_home_path" ]] || [[ ! "$agents_home_path" -ef "$repo_agents" ]]; then
  if [[ -e "$agents_home_path" || -L "$agents_home_path" ]]; then
    mkdir -p "$backup_root"
    mv "$agents_home_path" "$backup_root/agents"
    log "backed up $agents_home_path to $backup_root/agents"
  fi
  ln -s "$repo_agents" "$agents_home_path"
fi

for managed_path in "${managed_files[@]}"; do
  relative_path="${managed_path#.codex/}"
  source="$repo_codex/$relative_path"
  destination="$codex_home_path/$relative_path"
  [[ -e "$source" || -L "$source" ]] || die "missing tracked source: $source"
  mkdir -p "$(dirname "$destination")"
  if is_expected_link "$destination" "$source"; then
    continue
  fi
  if [[ -e "$destination" || -L "$destination" ]]; then
    backup_path="$backup_root/codex/$relative_path"
    mkdir -p "$(dirname "$backup_path")"
    mv "$destination" "$backup_path"
    log "backed up $destination to $backup_path"
  fi
  ln -s "$source" "$destination"
done

check_layout
